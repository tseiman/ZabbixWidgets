{
  "manifest_version": 2.0,
  "id": "pbs_running",
  "type": "widget",
  "name": "PBS Running Tasks",
  "namespace": "PbsRunning",
  "version": "1.0.5",
  "author": "PBS Dashboard",
  "description": "PBS panel using Zabbix items and history.",
  "widget": {
    "js_class": "CWidgetPbsRunning",
    "size": {
      "width": 36,
      "height": 5
    }
  },
  "actions": {
    "widget.pbs_running.view": {
      "class": "WidgetView"
    },
    "widget.pbs_running.log": {
      "class": "TaskLog",
      "layout": "layout.json"
    }
  },
  "assets": {
    "css": [
      "pbs.css"
    ],
    "js": [
      "class.widget.js"
    ]
  }
}
