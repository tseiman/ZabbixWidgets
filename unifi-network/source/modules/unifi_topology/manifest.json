{
  "manifest_version": 2,
  "id": "unifi_topology",
  "type": "widget",
  "name": "UniFi Topologie",
  "namespace": "UniFiTopology",
  "version": "0.3.3",
  "author": "Local extension",
  "description": "Read-only UniFi topology with per-device RX/TX history, expandable endpoints and Zabbix problem severity.",
  "widget": {
    "size": {
      "width": 24,
      "height": 9
    },
    "js_class": "CWidgetUniFiTopology"
  },
  "actions": {
    "widget.unifi_topology.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "js": [
      "class.widget.js"
    ],
    "css": [
      "widget.css"
    ]
  }
}
